# ── OpenCode Go (OpenAI-compatible) — reasoning + vision ────────────────────
# Subscribe at https://opencode.ai/auth, copy the API key from the console.
# One key covers both the LLM and the vision model.
OPENCODE_API_KEY=

# Base URL and model overrides (defaults already target OpenCode Go).
LLM_PROVIDER_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4.1-flash
# Stronger mother-tongue reasoning if needed: deepseek-v4-pro
VISION_BASE_URL=https://opencode.ai/zen/go/v1
VISION_MODEL=deepseek-v4-flash-vision-exp

# ── TTS (ElevenLabs) — spec 04 ──────────────────────────────────────────────
# Cebuano requires the Eleven v3 model. Set a voice id per language.
ELEVENLABS_API_KEY=
VOICE_FIL=
VOICE_CEB=

# ── Model output budget (reasoning models need headroom) ────────────────────
LLM_MAX_TOKENS=1500
VISION_MAX_TOKENS=1500

# ── Caps & rates (pesos) — spec 03 ──────────────────────────────────────────
CAP_MIN_PER_SESSION=10
CAP_MIN_PER_WEEK=30
CAP_SCANS_PER_SESSION=3
CAP_SESSIONS_PER_DAY=3
RATE_LLM_PHP_PER_1K_TOKENS=0.35
RATE_TTS_PHP_PER_1K_CHARS=3.3
RATE_STT_PHP_PER_MIN=0
RATE_VISION_PHP_PER_CALL=0.3
