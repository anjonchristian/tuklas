# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080

# ── Database (Supabase Postgres) ────────────────────────────────────────────
# Use the POOLED connection string (Project → Connect → Connection pooling).
# Format: postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
# When empty, the server falls back to an in-memory store.
DATABASE_URL=postgresql://postgres.jnfegvodjkqsqectopfb:[YOUR-DB-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── Supabase project (tulay, ap-southeast-1) ────────────────────────────────
SUPABASE_URL=https://jnfegvodjkqsqectopfb.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_EnaZt-_3dsq-D4_B_mdbUA_3bHbOxzQ
# Required only for server-side admin (bypasses RLS). Keep secret; never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenCode Go (LLM + vision) ──────────────────────────────────────────────
OPENCODE_API_KEY=
LLM_PROVIDER_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_MAX_TOKENS=1500
LLM_REASONING_EFFORT=none
VISION_MODEL=deepseek-v4-flash-vision-exp

# ── ElevenLabs (voice) ──────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
VOICE_FIL=Xb7hH8MSUJpSbSDYk0k2
VOICE_CEB=Xb7hH8MSUJpSbSDYk0k2
ELEVENLABS_DEFAULT_VOICE=Xb7hH8MSUJpSbSDYk0k2

# ── Caps (server-enforced) ──────────────────────────────────────────────────
CAP_MIN_PER_SESSION=10
CAP_MIN_PER_WEEK=30
CAP_SCANS_PER_SESSION=3
CAP_SESSIONS_PER_DAY=3

# Comma-separated allowed origins for CORS (the web app). Use * for dev.
CORS_ORIGIN=*

# ── Usage & cost (optional) ─────────────────────────────────────────────────
# Per-session counters (LLM tokens, TTS chars, STT seconds) are always recorded.
# Set these unit prices to turn the counters into an estimated ₱ cost; leave 0 to
# report the raw counters only (costPhp: null). All values are estimates.
PRICE_LLM_PER_MTOK=0
PRICE_TTS_PER_MCHAR=0
PRICE_STT_PER_MIN=0
# Pre-bake greetings/ask-back for each voiced language at boot (1 = on).
PREWARM_TTS=1
